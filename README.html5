<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Monde 3D - Immeubles</title>

<style>
html,body{
    margin:0;
    width:100%;
    height:100%;
    overflow:hidden;
    background:#000;
}

canvas{
    display:block;
}

#viseur{
    position:fixed;
    left:50%;
    top:50%;
    width:5px;
    height:5px;
    transform:translate(-50%,-50%);
    border:2px solid white;
    border-radius:50%;
    z-index:30;
    pointer-events:none;
}

#commandes{
    position:fixed;
    top:15px;
    left:50%;
    transform:translateX(-50%);
    padding:10px 18px;
    color:white;
    background:rgba(0,0,0,.72);
    border-radius:12px;
    font:14px Arial;
    z-index:30;
    pointer-events:none;
    text-align:center;
}

#vitesse{
    position:fixed;
    right:15px;
    top:15px;
    color:white;
    background:rgba(0,0,0,.65);
    padding:8px 12px;
    border-radius:10px;
    font:16px Arial;
    z-index:30;
}

/* RADAR */

#radar{
    position:fixed;
    left:18px;
    bottom:18px;
    width:190px;
    height:190px;
    background:rgba(0,0,0,.72);
    border:3px solid rgba(255,255,255,.8);
    border-radius:50%;
    z-index:40;
    overflow:hidden;
    box-shadow:0 0 18px rgba(0,0,0,.9);
}

#radarCanvas{
    width:100%;
    height:100%;
    display:block;
}

#radarTitre{
    position:absolute;
    left:50%;
    top:6px;
    transform:translateX(-50%);
    color:white;
    font:bold 11px Arial;
    text-shadow:0 1px 3px #000;
    pointer-events:none;
}

#radarJoueur{
    position:absolute;
    left:50%;
    top:50%;
    width:10px;
    height:10px;
    background:red;
    border:2px solid white;
    border-radius:50%;
    transform:translate(-50%,-50%);
    box-shadow:0 0 8px red;
    pointer-events:none;
}

/* CARTE */

#menuCarte{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.82);
    z-index:100;
    display:none;
    align-items:center;
    justify-content:center;
    font-family:Arial;
}

#menuCarte.visible{
    display:flex;
}

#carteCadre{
    width:min(850px,90vw);
    height:min(850px,90vh);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
}

#titreCarte{
    color:white;
    font-size:30px;
    font-weight:bold;
    margin-bottom:18px;
}

#carte{
    width:min(700px,78vw);
    height:min(700px,78vw);
    max-height:72vh;
    background:#2fa83f;
    border:6px solid #111;
    box-shadow:0 0 30px #000;
    position:relative;
    overflow:hidden;
}

.ligneCarte{
    position:absolute;
    background:#000;
    z-index:1;
}

.ligneVerticale{
    top:0;
    bottom:0;
    width:5px;
}

.ligneHorizontale{
    left:0;
    right:0;
    height:5px;
}

.blocCarte{
    position:absolute;
    background:#777;
    border:1px solid #555;
    box-sizing:border-box;
    z-index:3;
}

#joueurCarte{
    position:absolute;
    width:14px;
    height:14px;
    background:red;
    border:3px solid white;
    border-radius:50%;
    transform:translate(-50%,-50%);
    z-index:10;
    box-shadow:0 0 8px red;
}
</style>
</head>

<body>

<div id="viseur"></div>

<div id="commandes">
↑ ↓ ← → Déplacement |
3 appuis rapides = COURSE |
Q/W Caméra |
R/T Tourner |
E Vue |
Y Carte
</div>

<div id="vitesse">🚶 MARCHE</div>

<div id="radar">
    <canvas id="radarCanvas" width="380" height="380"></canvas>
    <div id="radarTitre">RADAR</div>
    <div id="radarJoueur"></div>
</div>

<div id="menuCarte">

    <div id="carteCadre">

        <div id="titreCarte">
            🗺️ CARTE DU MONDE
        </div>

        <div id="carte">
            <div id="joueurCarte"></div>
        </div>

        <div style="
            margin-top:18px;
            color:white;
            font-size:15px;
            background:rgba(255,255,255,.12);
            padding:8px 16px;
            border-radius:8px">
            Appuie sur Y ou Échap pour fermer
        </div>

    </div>

</div>

<script type="module">

import * as THREE from
"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js";


/* =====================================================
   MONDE
===================================================== */

const TAILLE_CUBE=1500;
const DEMI_CUBE=TAILLE_CUBE/2;
const solY=-DEMI_CUBE;

const nombreCases=12;
const espace=TAILLE_CUBE/nombreCases;

const scene=new THREE.Scene();

const camera=new THREE.PerspectiveCamera(
    75,
    innerWidth/innerHeight,
    .1,
    3000
);

const renderer=new THREE.WebGLRenderer({
    antialias:false
});

renderer.setPixelRatio(
    Math.min(devicePixelRatio,1.2)
);

renderer.setSize(
    innerWidth,
    innerHeight
);

renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;

document.body.appendChild(
    renderer.domElement
);


/* =====================================================
   CIEL
===================================================== */

const loader=new THREE.TextureLoader();

loader.setCrossOrigin("anonymous");

const cielTexture=loader.load(
"https://media.ouest-france.fr/v1/pictures/a7a7fb6c8e06451ddf269ee410f656d5-25454470.jpg?width=1260&client_id=eds&sign=932021968417f4769b15acf734f5c2cc9e962268effdd5bf4527620ed45c3d46"
);

const cielMaterial=
    new THREE.MeshBasicMaterial({
        map:cielTexture,
        side:THREE.BackSide
    });


/* =====================================================
   SOL
===================================================== */

const resolution=1024;

const canvasSol=
    document.createElement("canvas");

canvasSol.width=resolution;
canvasSol.height=resolution;

const ctxSol=
    canvasSol.getContext("2d");

ctxSol.fillStyle="#2fa83f";

ctxSol.fillRect(
    0,
    0,
    resolution,
    resolution
);

ctxSol.strokeStyle="#000";
ctxSol.lineWidth=35;

const tailleCase=
    resolution/nombreCases;

for(let i=0;i<=nombreCases;i++){

    const p=i*tailleCase;

    ctxSol.beginPath();
    ctxSol.moveTo(p,0);
    ctxSol.lineTo(p,resolution);
    ctxSol.stroke();

    ctxSol.beginPath();
    ctxSol.moveTo(0,p);
    ctxSol.lineTo(resolution,p);
    ctxSol.stroke();
}

const textureSol=
    new THREE.CanvasTexture(canvasSol);

textureSol.colorSpace=
    THREE.SRGBColorSpace;

const solMaterial=
    new THREE.MeshBasicMaterial({
        map:textureSol,
        side:THREE.BackSide
    });


const cube=new THREE.Mesh(
    new THREE.BoxGeometry(
        TAILLE_CUBE,
        TAILLE_CUBE,
        TAILLE_CUBE
    ),
    [
        cielMaterial,
        cielMaterial,
        cielMaterial,
        solMaterial,
        cielMaterial,
        cielMaterial
    ]
);

scene.add(cube);


/* =====================================================
   ZONE DES ARBRES
===================================================== */

const caseDolineX=5;
const caseDolineZ=5;

const centreX=
    -DEMI_CUBE+
    (caseDolineX+.5)*espace;

const centreZ=
    -DEMI_CUBE+
    (caseDolineZ+.5)*espace;

const rayonZone=
    espace*.44;


/* =====================================================
   COLLISIONS
===================================================== */

const objetsCollision=[];

function ajouterCollision(
    x,
    z,
    rayon,
    type="objet"
){

    objetsCollision.push({
        x:x,
        z:z,
        rayon:rayon,
        type:type
    });
}


/* =====================================================
   ARBRES
===================================================== */

const arbres=[];

function creerArbre(
    x,
    z,
    echelle=1
){

    const arbre=
        new THREE.Group();

    const tronc=new THREE.Mesh(
        new THREE.CylinderGeometry(
            2.2*echelle,
            3*echelle,
            22*echelle,
            7
        ),
        new THREE.MeshStandardMaterial({
            color:0x6b4328,
            roughness:1
        })
    );

    tronc.position.y=
        solY+
        11*echelle;

    arbre.add(tronc);


    const feuillage=new THREE.Mesh(
        new THREE.ConeGeometry(
            11*echelle,
            27*echelle,
            8
        ),
        new THREE.MeshStandardMaterial({
            color:0x176b2b,
            roughness:1
        })
    );

    feuillage.position.y=
        solY+
        32*echelle;

    arbre.add(feuillage);


    arbre.position.set(
        x,
        0,
        z
    );

    scene.add(arbre);


    ajouterCollision(
        x,
        z,
        5.5*echelle,
        "arbre"
    );


    arbres.push({
        objet:arbre,
        x:x,
        z:z,
        rayon:5.5*echelle
    });
}


for(let i=0;i<95;i++){

    const a=
        Math.random()*
        Math.PI*2;

    const r=
        Math.sqrt(Math.random())*
        rayonZone;

    const x=
        centreX+
        Math.cos(a)*r;

    const z=
        centreZ+
        Math.sin(a)*r;

    creerArbre(
        x,
        z,
        .55+
        Math.random()*.55
    );
}


/* =====================================================
   IMMEUBLES
===================================================== */

const blocs=
    new THREE.Group();


const blocMateriaux=[

    new THREE.MeshStandardMaterial({
        color:0x777777,
        roughness:.85
    }),

    new THREE.MeshStandardMaterial({
        color:0x9b5c42,
        roughness:.85
    }),

    new THREE.MeshStandardMaterial({
        color:0x4f6878,
        roughness:.85
    }),

    new THREE.MeshStandardMaterial({
        color:0x806f55,
        roughness:.85
    })
];


const blocTaille=28;
const blocHauteur=80;


/* =====================================================
   LISTE DES IMMEUBLES
===================================================== */

const immeubles=[];

for(
    let x=-DEMI_CUBE+espace/2;
    x<DEMI_CUBE;
    x+=espace
){

    for(
        let z=-DEMI_CUBE+espace/2;
        z<DEMI_CUBE;
        z+=espace
    ){

        const dansZone=
            Math.abs(x-centreX)<
            espace*.47 &&
            Math.abs(z-centreZ)<
            espace*.47;

        if(dansZone)
            continue;


        const ecart=
            blocTaille+8;

        const positions=[
            [-ecart/2,-ecart/2],
            [ ecart/2,-ecart/2],
            [-ecart/2, ecart/2],
            [ ecart/2, ecart/2]
        ];


        for(const p of positions){

            immeubles.push({
                x:x+p[0],
                z:z+p[1],
                materiau:
                    Math.floor(
                        Math.random()*
                        blocMateriaux.length
                    )
            });
        }
    }
}


/* =====================================================
   CORPS DES IMMEUBLES
===================================================== */

const geometrieImmeuble=
    new THREE.BoxGeometry(
        blocTaille,
        blocHauteur,
        blocTaille
    );


const meshesImmeubles=[];


for(
    let m=0;
    m<blocMateriaux.length;
    m++
){

    const liste=
        immeubles.filter(
            b=>b.materiau===m
        );

    if(liste.length===0)
        continue;


    const mesh=
        new THREE.InstancedMesh(
            geometrieImmeuble,
            blocMateriaux[m],
            liste.length
        );

    const matrice=
        new THREE.Matrix4();

    for(
        let i=0;
        i<liste.length;
        i++
    ){

        matrice.makeTranslation(
            liste[i].x,
            solY+
            blocHauteur/2,
            liste[i].z
        );

        mesh.setMatrixAt(
            i,
            matrice
        );
    }

    mesh.instanceMatrix.needsUpdate=true;

    mesh.castShadow=true;
    mesh.receiveShadow=true;

    blocs.add(mesh);

    meshesImmeubles.push(mesh);
}


/* =====================================================
   COLLISIONS DES IMMEUBLES
===================================================== */

for(const b of immeubles){

    ajouterCollision(
        b.x,
        b.z,
        blocTaille/2,
        "bloc"
    );
}

scene.add(blocs);


/* =====================================================
   FENÊTRES
   INSTANCEDMESH POUR ÉVITER TROP DE MESHES
===================================================== */

const fenetreMateriau=
    new THREE.MeshStandardMaterial({
        color:0x72cfff,
        roughness:.25,
        metalness:.05
    });


const geometrieFenetre=
    new THREE.BoxGeometry(
        4.2,
        5.5,
        .35
    );


/*
   16 fenêtres par immeuble :
   2 fenêtres × 2 niveaux × 4 côtés
*/

const nombreFenetres=
    immeubles.length*16;


const fenetres=
    new THREE.InstancedMesh(
        geometrieFenetre,
        fenetreMateriau,
        nombreFenetres
    );

fenetres.castShadow=false;
fenetres.receiveShadow=false;


const matriceFenetre=
    new THREE.Matrix4();

const rotationY=
    new THREE.Matrix4();

const positionFenetre=
    new THREE.Vector3();

let indexFenetre=0;


for(const b of immeubles){

    const baseY=
        solY+
        blocHauteur;


    const niveaux=[
        solY+27,
        solY+53
    ];


    for(const y of niveaux){

        /* =============================================
           FACE AVANT
        ============================================= */

        for(const px of [-7,7]){

            positionFenetre.set(
                b.x+px,
                y,
                b.z-blocTaille/2-.18
            );

            matriceFenetre.compose(
                positionFenetre,
                new THREE.Quaternion(),
                new THREE.Vector3(1,1,1)
            );

            fenetres.setMatrixAt(
                indexFenetre++,
                matriceFenetre
            );
        }


        /* =============================================
           FACE ARRIÈRE
        ============================================= */

        for(const px of [-7,7]){

            positionFenetre.set(
                b.x+px,
                y,
                b.z+blocTaille/2+.18
            );

            matriceFenetre.compose(
                positionFenetre,
                new THREE.Quaternion(),
                new THREE.Vector3(1,1,1)
            );

            fenetres.setMatrixAt(
                indexFenetre++,
                matriceFenetre
            );
        }


        /* =============================================
           CÔTÉ GAUCHE
        ============================================= */

        for(const pz of [-7,7]){

            positionFenetre.set(
                b.x-blocTaille/2-.18,
                y,
                b.z+pz
            );

            matriceFenetre.compose(
                positionFenetre,
                new THREE.Quaternion()
                    .setFromAxisAngle(
                        new THREE.Vector3(0,1,0),
                        Math.PI/2
                    ),
                new THREE.Vector3(1,1,1)
            );

            fenetres.setMatrixAt(
                indexFenetre++,
                matriceFenetre
            );
        }


        /* =============================================
           CÔTÉ DROIT
        ============================================= */

        for(const pz of [-7,7]){

            positionFenetre.set(
                b.x+blocTaille/2+.18,
                y,
                b.z+pz
            );

            matriceFenetre.compose(
                positionFenetre,
                new THREE.Quaternion()
                    .setFromAxisAngle(
                        new THREE.Vector3(0,1,0),
                        Math.PI/2
                    ),
                new THREE.Vector3(1,1,1)
            );

            fenetres.setMatrixAt(
                indexFenetre++,
                matriceFenetre
            );
        }
    }
}

fenetres.count=indexFenetre;
fenetres.instanceMatrix.needsUpdate=true;

scene.add(fenetres);


/* =====================================================
   PORTES
===================================================== */

const porteMateriau=
    new THREE.MeshStandardMaterial({
        color:0x321b12,
        roughness:.75
    });


const geometriePorte=
    new THREE.BoxGeometry(
        5.5,
        10,
        .5
    );


const portes=
    new THREE.InstancedMesh(
        geometriePorte,
        porteMateriau,
        immeubles.length
    );


const matricePorte=
    new THREE.Matrix4();

const positionPorte=
    new THREE.Vector3();


for(
    let i=0;
    i<immeubles.length;
    i++
){

    const b=
        immeubles[i];


    positionPorte.set(
        b.x,
        solY+5,
        b.z-blocTaille/2-.25
    );


    matricePorte.compose(
        positionPorte,
        new THREE.Quaternion(),
        new THREE.Vector3(1,1,1)
    );


    portes.setMatrixAt(
        i,
        matricePorte
    );
}

portes.instanceMatrix.needsUpdate=true;

scene.add(portes);


/* =====================================================
   LUMIÈRES
===================================================== */

scene.add(
    new THREE.HemisphereLight(
        0xffffff,
        0x444444,
        2
    )
);

const soleil=
    new THREE.DirectionalLight(
        0xffffff,
        2.2
    );

soleil.position.set(
    300,
    600,
    250
);

soleil.castShadow=true;

soleil.shadow.mapSize.width=1024;
soleil.shadow.mapSize.height=1024;

scene.add(soleil);


/* =====================================================
   MATÉRIAUX DU JOUEUR
===================================================== */

const peau=
    new THREE.MeshStandardMaterial({
        color:0xb8754f,
        roughness:.8
    });

const haut=
    new THREE.MeshStandardMaterial({
        color:0x111111,
        roughness:.8
    });

const pantalon=
    new THREE.MeshStandardMaterial({
        color:0x123b70,
        roughness:.85
    });

const chaussure=
    new THREE.MeshStandardMaterial({
        color:0x050505,
        roughness:.7
    });

const articulation=
    new THREE.MeshStandardMaterial({
        color:0x593b2a,
        roughness:.9
    });


/* =====================================================
   PERSONNAGE
===================================================== */

function creerPersonnage(
    couleurPeau,
    couleurHaut,
    couleurPantalon,
    couleurChaussure,
    couleurCheveux
){

    const personnage=
        new THREE.Group();


    const matPeau=peau.clone();
    matPeau.color.set(couleurPeau);

    const matHaut=haut.clone();
    matHaut.color.set(couleurHaut);

    const matPantalon=pantalon.clone();
    matPantalon.color.set(couleurPantalon);

    const matChaussure=chaussure.clone();
    matChaussure.color.set(couleurChaussure);

    const matArticulation=
        articulation.clone();


    const matCheveux=
        new THREE.MeshStandardMaterial({
            color:couleurCheveux,
            roughness:.8
        });


    function piece(
        geometrie,
        materiau,
        x,
        y,
        z
    ){

        const o=
            new THREE.Mesh(
                geometrie,
                materiau
            );

        o.position.set(
            x,
            y,
            z
        );

        o.castShadow=true;
        o.receiveShadow=true;

        personnage.add(o);

        return o;
    }


    /* CORPS */

    piece(
        new THREE.BoxGeometry(
            1.05,
            .55,
            .55
        ),
        matPantalon,
        0,
        2.15,
        0
    );


    piece(
        new THREE.CylinderGeometry(
            .52,
            .43,
            1.65,
            8
        ),
        matHaut,
        0,
        3.15,
        0
    );


    piece(
        new THREE.CylinderGeometry(
            .18,
            .18,
            .28,
            8
        ),
        matPeau,
        0,
        4.08,
        0
    );


    piece(
        new THREE.SphereGeometry(
            .48,
            12,
            8
        ),
        matPeau,
        0,
        4.65,
        0
    );


    /* CHEVEUX */

    const cheveux=piece(
        new THREE.SphereGeometry(
            .51,
            12,
            8,
            0,
            Math.PI*2,
            0,
            Math.PI*.58
        ),
        matCheveux,
        0,
        4.78,
        0
    );

    cheveux.scale.set(
        1.02,
        .72,
        1.02
    );


    for(let i=-3;i<=3;i++){

        const meche=piece(
            new THREE.ConeGeometry(
                .075,
                .28+
                Math.abs(i)*.025,
                5
            ),
            matCheveux,
            i*.11,
            5.03+
            Math.abs(i)*.015,
            -.34
        );

        meche.rotation.x=-.35;
    }


    /* VISAGE */

    const canvasVisage=
        document.createElement("canvas");

    canvasVisage.width=128;
    canvasVisage.height=128;

    const ctx=
        canvasVisage.getContext("2d");

    ctx.clearRect(
        0,
        0,
        128,
        128
    );

    ctx.strokeStyle="#111";
    ctx.fillStyle="#111";

    ctx.lineWidth=5;
    ctx.lineCap="round";


    ctx.beginPath();
    ctx.moveTo(27,53);
    ctx.lineTo(52,50);
    ctx.stroke();


    ctx.beginPath();
    ctx.moveTo(76,50);
    ctx.lineTo(101,53);
    ctx.stroke();


    ctx.beginPath();
    ctx.arc(
        45,
        52,
        3,
        0,
        Math.PI*2
    );
    ctx.fill();


    ctx.beginPath();
    ctx.arc(
        83,
        52,
        3,
        0,
        Math.PI*2
    );
    ctx.fill();


    ctx.lineWidth=3;

    ctx.beginPath();
    ctx.moveTo(64,55);
    ctx.lineTo(61,69);
    ctx.lineTo(67,69);
    ctx.stroke();


    ctx.lineWidth=4;

    ctx.beginPath();
    ctx.moveTo(50,85);
    ctx.lineTo(78,85);
    ctx.stroke();


    const textureVisage=
        new THREE.CanvasTexture(
            canvasVisage
        );

    textureVisage.colorSpace=
        THREE.SRGBColorSpace;


    const visageMaterial=
        new THREE.MeshBasicMaterial({
            map:textureVisage,
            transparent:true,
            depthWrite:false
        });


    piece(
        new THREE.PlaneGeometry(
            .72,
            .72
        ),
        visageMaterial,
        0,
        4.66,
        -.465
    );


    /* ÉPAULES */

    piece(
        new THREE.SphereGeometry(
            .25,
            8,
            8
        ),
        matHaut,
        -.58,
        3.72,
        0
    );

    piece(
        new THREE.SphereGeometry(
            .25,
            8,
            8
        ),
        matHaut,
        .58,
