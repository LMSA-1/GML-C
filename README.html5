   CARTE
===================================================== */

const menuCarte=
    document.getElementById(
        "menuCarte"
    );

const carte=
    document.getElementById(
        "carte"
    );

const joueurCarte=
    document.getElementById(
        "joueurCarte"
    );


function basculerCarte(){

    carteOuverte=
        !carteOuverte;

    menuCarte.classList.toggle(
        "visible",
        carteOuverte
    );


    if(carteOuverte)
        mettreAJourCarte();
}


/* =====================================================
   LIGNES CARTE
===================================================== */

for(
    let i=0;
    i<=nombreCases;
    i++
){

    const lv=
        document.createElement("div");

    lv.className=
        "ligneCarte ligneVerticale";

    lv.style.left=
        i/nombreCases*100+
        "%";

    carte.appendChild(lv);


    const lh=
        document.createElement("div");

    lh.className=
        "ligneCarte ligneHorizontale";

    lh.style.top=
        i/nombreCases*100+
        "%";

    carte.appendChild(lh);
}


/* =====================================================
   IMMEUBLES CARTE
===================================================== */

for(
    let r=0;
    r<nombreCases;
    r++
){

    for(
        let c=0;
        c<nombreCases;
        c++
    ){

        if(
            r===caseDolineZ &&
            c===caseDolineX
        )
            continue;


        const positions=[
            [14,14],
            [72,14],
            [14,72],
            [72,72]
        ];


        const w=
            100/nombreCases;


        for(
            const p of positions
        ){

            const b=
                document.createElement(
                    "div"
                );


            b.className=
                "blocCarte";


            b.style.left=
                (
                    c*w+
                    p[0]/100*w
                )+
                "%";


            b.style.top=
                (
                    r*w+
                    p[1]/100*w
                )+
                "%";


            b.style.width=
                w*.14+
                "%";


            b.style.height=
                w*.14+
                "%";


            carte.appendChild(b);
        }
    }
}


/* =====================================================
   ZONE ARBRES CARTE
===================================================== */

const arbresCarte=
    document.createElement("div");


arbresCarte.style.cssText=
`
position:absolute;
left:${caseDolineX/nombreCases*100}%;
top:${caseDolineZ/nombreCases*100}%;
width:${100/nombreCases}%;
height:${100/nombreCases}%;
background:#176b2b;
border-radius:50%;
z-index:4;
box-shadow:inset 0 0 20px #073b12;
`;


carte.appendChild(
    arbresCarte
);


function mettreAJourCarte(){

    joueurCarte.style.left=
        (
            (
                joueur.position.x+
                DEMI_CUBE
            )/
            TAILLE_CUBE*
            carte.clientWidth
        )+
        "px";


    joueurCarte.style.top=
        (
            (
                joueur.position.z+
                DEMI_CUBE
            )/
            TAILLE_CUBE*
            carte.clientHeight
        )+
        "px";
}


/* =====================================================
   RADAR
===================================================== */

const radarCanvas=
    document.getElementById(
        "radarCanvas"
    );

const radarCtx=
    radarCanvas.getContext("2d");


function mettreAJourRadar(){

    const w=
        radarCanvas.width;

    const h=
        radarCanvas.height;

    const cx=w/2;
    const cy=h/2;

    const rayon=w/2;


    radarCtx.clearRect(
        0,
        0,
        w,
        h
    );


    radarCtx.fillStyle=
        "#102010";

    radarCtx.beginPath();

    radarCtx.arc(
        cx,
        cy,
        rayon-3,
        0,
        Math.PI*2
    );

    radarCtx.fill();


    radarCtx.strokeStyle=
        "rgba(255,255,255,.18)";

    radarCtx.lineWidth=2;


    for(
        let r=50;
        r<rayon;
        r+=50
    ){

        radarCtx.beginPath();

        radarCtx.arc(
            cx,
            cy,
            r,
            0,
            Math.PI*2
        );

        radarCtx.stroke();
    }


    radarCtx.beginPath();
    radarCtx.moveTo(cx,0);
    radarCtx.lineTo(cx,h);
    radarCtx.stroke();

    radarCtx.beginPath();
    radarCtx.moveTo(0,cy);
    radarCtx.lineTo(w,cy);
    radarCtx.stroke();


    const echelle=
        .14;


    function positionRadar(
        x,
        z
    ){

        return {

            x:
                cx+
                (
                    x-
                    joueur.position.x
                )*
                echelle,

            y:
                cy+
                (
                    z-
                    joueur.position.z
                )*
                echelle
        };
    }


    /* IMMEUBLES */

    radarCtx.fillStyle=
        "#777";


    for(
        const o of objetsCollision
    ){

        if(o.type!=="bloc")
            continue;


        const pos=
            positionRadar(
                o.x,
                o.z
            );


        const taille=
            o.rayon*
            2*
            echelle;


        if(
            pos.x+taille<0 ||
            pos.x-taille>w ||
            pos.y+taille<0 ||
            pos.y-taille>h
        )
            continue;


        radarCtx.fillRect(
            pos.x-
            taille/2,
            pos.y-
            taille/2,
            Math.max(
                3,
                taille
            ),
            Math.max(
                3,
                taille
            )
        );
    }


    /* ARBRES */

    radarCtx.fillStyle=
        "#1fd33d";


    for(
        const arbre of arbres
    ){

        const pos=
            positionRadar(
                arbre.x,
                arbre.z
            );


        if(
            pos.x<0 ||
            pos.x>w ||
            pos.y<0 ||
            pos.y>h
        )
            continue;


        radarCtx.beginPath();

        radarCtx.arc(
            pos.x,
            pos.y,
            4,
            0,
            Math.PI*2
        );

        radarCtx.fill();
    }


    /* NPC */

    for(
        const n of npcs
    ){

        const p=
            n.personnage.position;


        const pos=
            positionRadar(
                p.x,
                p.z
            );


        if(
            pos.x<0 ||
            pos.x>w ||
            pos.y<0 ||
            pos.y>h
        )
            continue;


        radarCtx.fillStyle=
            "#2196ff";


        radarCtx.beginPath();

        radarCtx.arc(
            pos.x,
            pos.y,
            5,
            0,
            Math.PI*2
        );

        radarCtx.fill();


        radarCtx.strokeStyle=
            "white";

        radarCtx.lineWidth=1;

        radarCtx.stroke();
    }


    /* JOUEUR */

    radarCtx.fillStyle=
        "red";

    radarCtx.strokeStyle=
        "white";

    radarCtx.lineWidth=3;


    radarCtx.beginPath();

    radarCtx.arc(
        cx,
        cy,
        9,
        0,
        Math.PI*2
    );

    radarCtx.fill();
    radarCtx.stroke();


    const angle=
        joueur.rotation.y;

    radarCtx.strokeStyle=
        "white";

    radarCtx.lineWidth=3;

    radarCtx.beginPath();

    radarCtx.moveTo(
        cx,
        cy
    );

    radarCtx.lineTo(
        cx+
        Math.sin(angle)*
        17,
        cy+
        Math.cos(angle)*
        17
    );

    radarCtx.stroke();
}


/* =====================================================
   CLAVIER
===================================================== */

window.addEventListener(
    "keydown",
    e=>{

        if(
            e.key.toLowerCase()==="y"
        ){

            if(!e.repeat)
                basculerCarte();

            return;
        }


        if(e.key==="Escape"){

            if(carteOuverte){

                carteOuverte=false;

                menuCarte.classList.remove(
                    "visible"
                );
            }

            return;
        }


        if(carteOuverte)
            return;


        if([
            "ArrowUp",
            "ArrowDown",
            "ArrowLeft",
            "ArrowRight"
        ].includes(e.code)){

            e.preventDefault();


            const now=
                performance.now();


            compteur[e.code]=
                now-
                dernier[e.code]>
                .45*1000
                ?
                1
                :
                compteur[e.code]+1;


            dernier[e.code]=now;


            if(
                compteur[e.code]>=3
            ){

                course=true;

                compteur[e.code]=0;
            }


            touches[e.code]=true;
        }


        const k=
            e.key.toLowerCase();


        if(k in touches)
            touches[k]=true;
    }
);


window.addEventListener(
    "keyup",
    e=>{

        if([
            "ArrowUp",
            "ArrowDown",
            "ArrowLeft",
            "ArrowRight"
        ].includes(e.code)){

            touches[e.code]=false;


            if(
                !touches.ArrowUp &&
                !touches.ArrowDown &&
                !touches.ArrowLeft &&
                !touches.ArrowRight
            ){

                course=false;
            }
        }


        const k=
            e.key.toLowerCase();


        if(k in touches)
            touches[k]=false;
    }
);


/* =====================================================
   BOUCLE
===================================================== */

const horloge=
    new THREE.Clock();


function animate(){

    requestAnimationFrame(
        animate
    );


    const delta=
        Math.min(
            horloge.getDelta(),
            .05
        );


    changerVue();

    controlerCamera();


    if(!carteOuverte){

        deplacerJoueur(delta);

        deplacerNPC(delta);

        suivreJoueur();

    }else{

        mettreAJourCarte();
    }


    mettreAJourRadar();


    renderer.render(
        scene,
        camera
    );
}


animate();


/* =====================================================
   REDIMENSIONNEMENT
===================================================== */

addEventListener(
    "resize",
    ()=>{

        camera.aspect=
            innerWidth/
            innerHeight;


        camera.updateProjectionMatrix();


        renderer.setSize(
            innerWidth,
            innerHeight
        );


        if(carteOuverte)
            mettreAJourCarte();
    }
);

</script>

</body>
</html>
