/* =====================================================
   ANIMATION
===================================================== */

function animationPersonnage(
    personnage,
    delta,
    mouvement,
    course
){

    const a=
        personnage.userData.animation;


    if(!mouvement){

        const amortissement=.78;

        a.cuisseG.rotation.x*=amortissement;
        a.cuisseD.rotation.x*=amortissement;

        a.molletG.rotation.x*=amortissement;
        a.molletD.rotation.x*=amortissement;

        a.brasG.rotation.x*=amortissement;
        a.brasD.rotation.x*=amortissement;

        a.avantBrasG.rotation.x*=amortissement;
        a.avantBrasD.rotation.x*=amortissement;

        return;
    }


    a.temps+=
        delta*
        (course?11:6);


    const p=
        Math.sin(a.temps);

    const p2=
        Math.sin(
            a.temps+
            Math.PI
        );


    const amplitude=
        course?.62:.42;


    a.cuisseG.rotation.x=
        p*amplitude;

    a.cuisseD.rotation.x=
        p2*amplitude;


    const flexG=
        Math.max(0,p)*.45;

    const flexD=
        Math.max(0,p2)*.45;


    a.molletG.rotation.x=
        -flexG;

    a.molletD.rotation.x=
        -flexD;


    a.brasG.rotation.x=
        -p*amplitude*.72;

    a.brasD.rotation.x=
        -p2*amplitude*.72;


    a.avantBrasG.rotation.x=
        -p*amplitude*.30;

    a.avantBrasD.rotation.x=
        -p2*amplitude*.30;


    a.coudeG.rotation.z=
        Math.max(0,p)*.12;

    a.coudeD.rotation.z=
        Math.max(0,p2)*.12;


    a.piedG.position.y=
        -.68+
        Math.max(0,p)*
        (course?.22:.13);

    a.piedD.position.y=
        -.68+
        Math.max(0,p2)*
        (course?.22:.13);


    a.piedG.position.z=
        -.12+
        Math.max(0,p)*
        (course?.18:.10);

    a.piedD.position.z=
        -.12+
        Math.max(0,p2)*
        (course?.18:.10);
}


/* =====================================================
   NPC
===================================================== */

const npcs=[];

const couleursNPC=[

    [0xb8754f,0x6b1f1f,0x183d70,0x050505,0x24150f],

    [0x8c5a3c,0x173d28,0x39286b,0x171717,0x151515],

    [0xc58a62,0x43246b,0x173c3c,0x202020,0x301b10],

    [0x6f402c,0x263d7a,0x6b351e,0x090909,0x0d0d0d],

    [0xa96845,0x164d58,0x283c78,0x111111,0x402010],

    [0xd0966e,0x593015,0x194f30,0x080808,0x181818],

    [0x75452f,0x242424,0x5b2248,0x111111,0x0c0c0c],

    [0xb97751,0x193d64,0x493d18,0x050505,0x28140b]
];


function creerNPC(
    x,
    z,
    index
){

    const c=
        couleursNPC[
            index%
            couleursNPC.length
        ];


    const npc=
        creerPersonnage(
            c[0],
            c[1],
            c[2],
            c[3],
            c[4]
        );


    npc.scale.set(
        .95,
        .95,
        .95
    );


    npc.position.set(
        x,
        solY+.5,
        z
    );


    scene.add(npc);


    npcs.push({

        personnage:npc,

        phase:
            Math.random()*
            Math.PI*2,

        vitesse:
            .65+
            Math.random()*.45,

        rayon:2.5,

        direction:
            Math.random()*
            Math.PI*2
    });
}


/* =====================================================
   COLLISION
===================================================== */

const rayonJoueur=.65;


function collisionPosition(
    x,
    z,
    rayon,
    ignorerNPC=null
){

    for(
        const o of objetsCollision
    ){

        if(o.type==="bloc"){

            const demi=
                o.rayon;

            const procheX=
                THREE.MathUtils.clamp(
                    x,
                    o.x-demi,
                    o.x+demi
                );

            const procheZ=
                THREE.MathUtils.clamp(
                    z,
                    o.z-demi,
                    o.z+demi
                );

            const dx=
                x-procheX;

            const dz=
                z-procheZ;


            if(
                dx*dx+
                dz*dz<
                rayon*rayon
            ){

                return true;
            }

        }else{

            const dx=
                x-o.x;

            const dz=
                z-o.z;


            if(
                dx*dx+
                dz*dz<
                (rayon+o.rayon)*
                (rayon+o.rayon)
            ){

                return true;
            }
        }
    }


    for(
        const n of npcs
    ){

        if(n===ignorerNPC)
            continue;


        const dx=
            x-
            n.personnage.position.x;

        const dz=
            z-
            n.personnage.position.z;


        if(
            dx*dx+
            dz*dz<
            (rayon+n.rayon)*
            (rayon+n.rayon)
        ){

            return true;
        }
    }


    if(
        ignorerNPC!==null
    ){

        const dx=
            x-
            joueur.position.x;

        const dz=
            z-
            joueur.position.z;


        if(
            dx*dx+
            dz*dz<
            (rayon+rayonJoueur)*
            (rayon+rayonJoueur)
        ){

            return true;
        }
    }


    return false;
}


/* =====================================================
   PLACEMENT NPC
===================================================== */

for(let i=0;i<50;i++){

    let placee=false;

    for(
        let tentative=0;
        tentative<60&&!placee;
        tentative++
    ){

        const x=
            -DEMI_CUBE+
            20+
            Math.random()*
            (TAILLE_CUBE-40);

        const z=
            -DEMI_CUBE+
            20+
            Math.random()*
            (TAILLE_CUBE-40);


        let libre=true;


        for(const arbre of arbres){

            const dx=
                x-arbre.x;

            const dz=
                z-arbre.z;


            if(
                Math.hypot(dx,dz)<
                arbre.rayon+3
            ){

                libre=false;
                break;
            }
        }


        if(libre){

            if(
                collisionPosition(
                    x,
                    z,
                    2.5
                )
            ){

                libre=false;
            }
        }


        if(libre){

            const dx=
                x-joueur.position.x;

            const dz=
                z-joueur.position.z;

            if(
                Math.hypot(dx,dz)<8
            ){

                libre=false;
            }
        }


        if(libre){

            creerNPC(
                x,
                z,
                i
            );

            placee=true;
        }
    }
}


/* =====================================================
   DÉPLACEMENT NPC
===================================================== */

function deplacerNPC(delta){

    for(
        const n of npcs
    ){

        const p=
            n.personnage;


        const directionX=
            Math.sin(n.direction);

        const directionZ=
            Math.cos(n.direction);


        const vitesse=
            n.vitesse*2;


        const nx=
            p.position.x+
            directionX*
            vitesse*
            delta;

        const nz=
            p.position.z+
            directionZ*
            vitesse*
            delta;


        let mouvement=false;


        if(
            !collisionPosition(
                nx,
                p.position.z,
                n.rayon,
                n
            )
        ){

            p.position.x=
                nx;

            mouvement=true;

        }else{

            n.direction+=
                (Math.random()-.5)*
                Math.PI;
        }


        if(
            !collisionPosition(
                p.position.x,
                nz,
                n.rayon,
                n
            )
        ){

            p.position.z=
                nz;

            mouvement=true;

        }else{

            n.direction+=
                (Math.random()-.5)*
                Math.PI;
        }


        const marge=3;


        if(
            p.position.x<
            -DEMI_CUBE+marge
        ){

            p.position.x=
                -DEMI_CUBE+marge;

            n.direction=
                Math.random()*
                Math.PI*2;
        }


        if(
            p.position.x>
            DEMI_CUBE-marge
        ){

            p.position.x=
                DEMI_CUBE-marge;

            n.direction=
                Math.random()*
                Math.PI*2;
        }


        if(
            p.position.z<
            -DEMI_CUBE+marge
        ){

            p.position.z=
                -DEMI_CUBE+marge;

            n.direction=
                Math.random()*
                Math.PI*2;
        }


        if(
            p.position.z>
            DEMI_CUBE-marge
        ){

            p.position.z=
                DEMI_CUBE-marge;

            n.direction=
                Math.random()*
                Math.PI*2;
        }


        p.rotation.y=
            n.direction;


        animationPersonnage(
            p,
            delta,
            mouvement,
            false
        );
    }
}


/* =====================================================
   TOUCHES
===================================================== */

const touches={

    ArrowUp:false,
    ArrowDown:false,
    ArrowLeft:false,
    ArrowRight:false,

    q:false,
    w:false,
    e:false,
    r:false,
    t:false
};


const compteur={

    ArrowUp:0,
    ArrowDown:0,
    ArrowLeft:0,
    ArrowRight:0
};


const dernier={

    ArrowUp:0,
    ArrowDown:0,
    ArrowLeft:0,
    ArrowRight:0
};


let course=false;

let carteOuverte=false;

let rotationHorizontale=0;

let rotationVerticale=0;

let modeVue=0;

let toucheEPrecedente=false;

const vitesseRotation=.035;

const limiteVerticale=
    Math.PI/2.5;

const vitesseSuiviCamera=.10;


/* =====================================================
   DÉPLACEMENT JOUEUR
===================================================== */

function deplacerJoueur(delta){

    let avant=0;
    let cote=0;


    if(touches.ArrowUp)
        avant++;

    if(touches.ArrowDown)
        avant--;

    if(touches.ArrowLeft)
        cote--;

    if(touches.ArrowRight)
        cote++;


    const move=
        Math.abs(avant)+
        Math.abs(cote)>0;


    const vitesse=
        course?
        2.3:
        .35;


    document.getElementById(
        "vitesse"
    ).textContent=
        course?
        "🏃 COURSE":
        "🚶 MARCHE";


    avant*=vitesse;
    cote*=vitesse;


    const da=
        new THREE.Vector3(
            Math.sin(rotationHorizontale),
            0,
            -Math.cos(rotationHorizontale)
        );


    const dd=
        new THREE.Vector3(
            Math.cos(rotationHorizontale),
            0,
            Math.sin(rotationHorizontale)
        );


    const dx=
        da.x*avant+
        dd.x*cote;

    const dz=
        da.z*avant+
        dd.z*cote;


    const nx=
        joueur.position.x+
        dx*delta*60;

    const nz=
        joueur.position.z+
        dz*delta*60;


    if(
        !collisionPosition(
            nx,
            joueur.position.z,
            rayonJoueur
        )
    ){

        joueur.position.x=
            nx;
    }


    if(
        !collisionPosition(
            joueur.position.x,
            nz,
            rayonJoueur
        )
    ){

        joueur.position.z=
            nz;
    }


    if(
        Math.hypot(dx,dz)>.001
    ){

        joueur.rotation.y=
            Math.atan2(dx,dz)+
            Math.PI;


        const cible=
            Math.atan2(dx,-dz);


        let diff=
            cible-
            rotationHorizontale;


        while(diff>Math.PI)
            diff-=Math.PI*2;

        while(diff<-Math.PI)
            diff+=Math.PI*2;


        rotationHorizontale+=
            diff*
            vitesseSuiviCamera;
    }


    animationPersonnage(
        joueur,
        delta,
        move,
        course
    );


    joueur.position.x=
        THREE.MathUtils.clamp(
            joueur.position.x,
            -DEMI_CUBE+2,
            DEMI_CUBE-2
        );


    joueur.position.z=
        THREE.MathUtils.clamp(
            joueur.position.z,
            -DEMI_CUBE+2,
            DEMI_CUBE-2
        );


    joueur.position.y=
        solY+.5;
}


/* =====================================================
   CAMÉRA
===================================================== */

function changerVue(){

    if(
        touches.e &&
        !toucheEPrecedente
    ){

        modeVue++;

        if(modeVue>2)
            modeVue=0;
    }


    toucheEPrecedente=
        touches.e;
}


function controlerCamera(){

    if(touches.q)
        rotationVerticale+=
            vitesseRotation;

    if(touches.w)
        rotationVerticale-=
            vitesseRotation;

    if(touches.r)
        rotationHorizontale+=
            vitesseRotation;

    if(touches.t)
        rotationHorizontale-=
            vitesseRotation;


    rotationVerticale=
        THREE.MathUtils.clamp(
            rotationVerticale,
            -limiteVerticale,
            limiteVerticale
        );
}


function suivreJoueur(){

    const distance=
        modeVue===0?
        12:
        modeVue===1?
        5:
        0;


    const hauteur=
        modeVue===0?
        5.5:
        modeVue===1?
        3.5:
        4.5;


    const d=
        new THREE.Vector3(
            Math.sin(rotationHorizontale),
            Math.sin(rotationVerticale),
            -Math.cos(rotationHorizontale)
        ).normalize();


    camera.position.set(
        joueur.position.x,
        joueur.position.y+
        hauteur,
        joueur.position.z
    );


    if(modeVue!==2){

        camera.position.sub(
            d.clone().multiplyScalar(
                distance
            )
        );
    }


    const cible=
        joueur.position.clone();

    cible.y+=3;


    cible.add(
        d.clone().multiplyScalar(20)
    );


    camera.lookAt(cible);
}


